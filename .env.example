# Copy this file to .env (`cp .env.example .env`) and fill in the values
# below. The app auto-loads .env at startup via python-dotenv — no need to
# `export` anything yourself. Never commit a populated .env.

# ============================================================
# RECON API CREDENTIALS — fill these in to run a live rescan
# ============================================================

# Shodan        — https://account.shodan.io/
SHODAN_API_KEY=

# Censys v2     — https://search.censys.io/account/api
# Single Personal Access Token (PAT): set CENSYS_API_TOKEN only.
# Two-part API credential: set CENSYS_API_TOKEN to the API ID and
# CENSYS_API_SECRET to the secret half.
CENSYS_API_TOKEN=
CENSYS_API_SECRET=

# NVD (CVEs)    — optional, raises rate limit from 5 to 50 req / 30s.
#                 Request at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ============================================================
# Organisation under investigation
# ============================================================
DOJAA_ORG_DOMAIN=drexel.edu

# ============================================================
# Flask + auth
# ============================================================
# Long random string used to sign session cookies AND to derive the
# at-rest encryption key for cached scan data (via HKDF-SHA-256). Keep
# it secret and stable; rotating it invalidates encrypted cache files
# and forces a re-login. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Bypass /login entirely (only sane for local development).
DOJAA_AUTH_DISABLED=true

# Required email suffix for the demo login.
DOJAA_DEMO_EMAIL_DOMAIN=drexel.edu

# Demo login password. NEVER commit the plaintext. Two ways to set it:
#   1) Preferred — pre-hashed PBKDF2-SHA-256 string from werkzeug. Mint one with:
#        python -c "from werkzeug.security import generate_password_hash; \
#                   print(generate_password_hash('your-password', method='pbkdf2:sha256:600000'))"
#      then paste the full "pbkdf2:sha256:600000$..." string into:
DOJAA_DEMO_PASSWORD_HASH=
#   2) Fallback for local dev — plaintext, hashed at startup. Avoid in production.
DOJAA_DEMO_PASSWORD=

# ============================================================
# At-rest encryption (Fernet — AES-128-CBC + HMAC-SHA-256)
# ============================================================
# Dedicated Fernet key for cached scan data. If unset, derived from
# FLASK_SECRET_KEY via HKDF; if both are unset a key is auto-generated
# into <cache_dir>/.dojaa.key (dev convenience). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOJAA_DATA_KEY=

# ============================================================
# Pipeline tuning (defaults work fine — set only if you need to)
# ============================================================
DOJAA_CACHE_DIR=
DOJAA_SSL_PROBE_TIMEOUT=2.0
DOJAA_SSL_PROBE_LIMIT=50
DOJAA_CVE_PER_SERVICE=5
DOJAA_CVE_MAX_TOTAL=25

# ============================================================
# Optional Postgres loader (only for dojaa/writeToDb.py — the web app
# does not touch the database).
# ============================================================
DOJAA_DB_HOST=localhost
DOJAA_DB_PORT=5432
DOJAA_DB_NAME=dojaa
DOJAA_DB_USER=postgres
DOJAA_DB_PASSWORD=
