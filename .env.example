# Copy to .env (or export in your shell) before running DOJAA.
# Never commit a populated .env file.

# --- Flask ---
# Use a long random string in production. Leaving this blank generates a fresh
# random value on each startup, which logs out all sessions on restart.
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# --- Auth ---
# Set to true to bypass the login screen (only sane for local development).
DOJAA_AUTH_DISABLED=false
# Required email suffix for the demo login. Defaults to drexel.edu.
DOJAA_DEMO_EMAIL_DOMAIN=drexel.edu
# Required password for the demo login. Leave blank to disable form auth.
DOJAA_DEMO_PASSWORD=

# --- Organisation under investigation ---
DOJAA_ORG_DOMAIN=drexel.edu

# --- Recon API credentials ---
# Shodan:  https://account.shodan.io/
SHODAN_API_KEY=
# Censys:  https://search.censys.io/account/api  (API id is the token; password
# field on Basic auth stays empty per Censys docs).
CENSYS_API_TOKEN=
# NVD (CVE) — optional, but raises rate limit from 5 to 50 req / 30s.
# Request at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Pipeline tuning ---
DOJAA_CACHE_DIR=
DOJAA_SSL_PROBE_TIMEOUT=2.0
DOJAA_SSL_PROBE_LIMIT=50
DOJAA_CVE_PER_SERVICE=5
DOJAA_CVE_MAX_TOTAL=25

# --- Optional Postgres loader (dojaa/writeToDb.py only — the web app does not
#     touch the database). ---
DOJAA_DB_HOST=localhost
DOJAA_DB_PORT=5432
DOJAA_DB_NAME=dojaa
DOJAA_DB_USER=postgres
DOJAA_DB_PASSWORD=
