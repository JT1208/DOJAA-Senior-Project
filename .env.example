# Copy this file to .env (`cp .env.example .env`) and fill in the values
# below. The app auto-loads .env at startup via python-dotenv — no need to
# `export` anything yourself. Never commit a populated .env.

# ============================================================
# RECON API CREDENTIALS — fill these in to run a live rescan
# ============================================================

# Shodan        — https://account.shodan.io/
SHODAN_API_KEY=

# Censys v2     — https://search.censys.io/account/api
# Single Personal Access Token (PAT): set CENSYS_API_TOKEN only.
# Two-part API credential: set CENSYS_API_TOKEN to the API ID and
# CENSYS_API_SECRET to the secret half.
CENSYS_API_TOKEN=
CENSYS_API_SECRET=

# NVD (CVEs)    — optional, raises rate limit from 5 to 50 req / 30s.
#                 Request at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ============================================================
# Organisation under investigation
# ============================================================
DOJAA_ORG_DOMAIN=drexel.edu

# ============================================================
# Flask + auth
# ============================================================
# Long random string. If blank, a fresh random key is generated each restart
# (which logs out all sessions on reload).
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Bypass /login entirely (only sane for local development).
DOJAA_AUTH_DISABLED=true
# Required email suffix for the demo login.
DOJAA_DEMO_EMAIL_DOMAIN=drexel.edu
# Demo login password. Default is "dojaa-demo" when this is unset.
DOJAA_DEMO_PASSWORD=

# ============================================================
# Pipeline tuning (defaults work fine — set only if you need to)
# ============================================================
DOJAA_CACHE_DIR=
DOJAA_SSL_PROBE_TIMEOUT=2.0
DOJAA_SSL_PROBE_LIMIT=50
DOJAA_CVE_PER_SERVICE=5
DOJAA_CVE_MAX_TOTAL=25

# ============================================================
# Optional Postgres loader (only for dojaa/writeToDb.py — the web app
# does not touch the database).
# ============================================================
DOJAA_DB_HOST=localhost
DOJAA_DB_PORT=5432
DOJAA_DB_NAME=dojaa
DOJAA_DB_USER=postgres
DOJAA_DB_PASSWORD=
